{
  "name": "bytescript",
  "displayName": "Bytescript",
  "description": "Syntax highlighting for the Bytescript programming language (.bs files)",
  "version": "1.1.0",
  "publisher": "bytescript",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/gefrus112/Bytescript" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "bytescript",
      "aliases": ["Bytescript", "bytescript"],
      "extensions": [".bs"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "bytescript",
      "scopeName": "source.bytescript",
      "path": "./syntaxes/bytescript.tmLanguage.json"
    }]
  }
}
