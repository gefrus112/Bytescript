-- fizzbuzz.bs - the classic, in Bytescript
-- Run it with:  bytescript exemples/fizzbuzz.bs

for i = 1, 20 repeat
    if i % 15 == 0 then
        print("FizzBuzz")
    end
    if i % 15 != 0 and i % 3 == 0 then
        print("Fizz")
    end
    if i % 15 != 0 and i % 5 == 0 then
        print("Buzz")
    end
    if i % 3 != 0 and i % 5 != 0 then
        print(i)
    end
end
